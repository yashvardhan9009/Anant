# Nebius Token Factory (OpenAI-compatible). Keys stay server-side; never exposed to the browser.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional: force a model id. If empty, ANANT queries /models and picks an NVIDIA Nemotron model.
ANANT_MODEL=
# Request timeout for model calls (ms)
ANANT_LLM_TIMEOUT_MS=15000
PORT=8787

# Optional Google Photorealistic 3D Tiles. Leave empty for public imagery/terrain.
# Unlike the Nebius secret, this key is intentionally sent to the browser:
# restrict it to Map Tiles API and your site's HTTP referrers in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
